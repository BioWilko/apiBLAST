# Local overrides for docker-compose.yml — copy to docker-compose.override.yml
# and edit for your installation. Docker Compose merges this automatically.
#
# This file is NOT loaded by default. It only takes effect once copied:
#   cp docker-compose.override.yml.example docker-compose.override.yml

# Mount your BLAST databases from the host (read-only).
# Replace /path/to/your/blast/databases with the directory that contains
# your BLAST index files (the directory, not an individual database).
# Paths in databases.yml should then start with /data/blast/db/.

volumes:
  blast_dbs:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /path/to/your/blast/databases
