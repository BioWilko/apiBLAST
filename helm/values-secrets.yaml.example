# Copy this file to values-secrets.yaml and fill in real values.
# values-secrets.yaml is gitignored — never commit it.
#
# Usage:
#   helm install apiblast helm/ -f values-secrets.yaml -n ns-cli-climb-gre-se
#   helm upgrade apiblast helm/ -f values-secrets.yaml -n ns-cli-climb-gre-se

credentials:
  # FastAPI SECRET_KEY — generate with: openssl rand -hex 32
  secretKey: "CHANGE_ME"

  # Password for the Postgres "apiblast" role. Only applied when initdb runs on
  # an empty apiblast/postgres folder; changing it later needs ALTER USER.
  postgresPassword: "CHANGE_ME"

  # Password must match postgresPassword.
  databaseUrl: "postgresql+psycopg2://apiblast:CHANGE_ME@apiblast-postgres:5432/apiblast"
