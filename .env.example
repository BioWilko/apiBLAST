# Local development settings. In Kubernetes these come from the Helm chart.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
APP_VERSION=2.0.0
LOG_LEVEL=INFO
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32

# ── Databases ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./apiblast.db
# DATABASE_URL=postgresql+psycopg2://apiblast:changeme@localhost:5432/apiblast

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MMseqs2 binary and data paths ────────────────────────────────────────────
MMSEQS_BIN=/opt/homebrew/bin/mmseqs      # macOS Homebrew
# MMSEQS_BIN=/usr/local/bin/mmseqs       # container image
RESULT_DIR=./data/results
DB_CONFIG=databases.yml

# ── MMseqs2 execution ─────────────────────────────────────────────────────────
MMSEQS_THREADS=1             # threads per search
MMSEQS_GPU_ENABLED=false     # route blastp/blastx to the blast_gpu queue (needs a GPU worker)

# ── Job execution limits ──────────────────────────────────────────────────────
JOB_SOFT_TIMEOUT_S=3600      # SIGTERM after 1 hour
JOB_HARD_TIMEOUT_S=3900      # SIGKILL after 1 hour 5 min (must be > soft)
MAX_QUERY_LENGTH_NT=500000   # max total nucleotides per submission
MAX_QUERY_LENGTH_AA=100000   # max total amino acids per submission
MAX_SEQUENCES_PER_JOB=100    # max FASTA records per submission

# ── Queue / concurrency ───────────────────────────────────────────────────────
# Run scripts/compute_concurrency.sh to get a recommended value for your machine.
CELERY_CONCURRENCY=4
MAX_QUEUE_DEPTH=16           # CELERY_CONCURRENCY * 4 is a good default
MAX_CONCURRENT_DBS=3         # max distinct databases active simultaneously
MEMORY_FLOOR_MB=512          # hard-reject jobs below this free RAM (MB)
COST_HEAVY_THRESHOLD=1000    # CPU jobs at or above this estimated cost are deprioritised

# ── Result retention ──────────────────────────────────────────────────────────
RESULT_TTL_S=86400           # 24 hours

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_SUBMIT_PER_MINUTE=10
RATE_LIMIT_SUBMIT_PER_HOUR=100
