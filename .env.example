# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
APP_VERSION=1.0.0
LOG_LEVEL=INFO
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32

# ── Databases ─────────────────────────────────────────────────────────────────
# SQLite (dev default):
DATABASE_URL=sqlite:///./apiblast.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg2://apiblast:changeme@db:5432/apiblast

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── BLAST binaries and data paths ────────────────────────────────────────────
BLAST_BIN_DIR=/opt/homebrew/bin          # macOS Homebrew
# BLAST_BIN_DIR=/usr/local/ncbi/blast/bin  # Linux NCBI installer
# BLAST_BIN_DIR=/usr/bin                   # Debian/Ubuntu package
BLAST_DB_DIR=/data/blast/db
BLAST_RESULT_DIR=/data/blast/results

# ── BLAST execution limits ────────────────────────────────────────────────────
BLAST_SOFT_TIMEOUT_S=3600    # SIGTERM after 1 hour
BLAST_HARD_TIMEOUT_S=3900    # SIGKILL after 1 hour 5 min (must be > soft)
MAX_QUERY_LENGTH_NT=500000   # max total nucleotides per submission
MAX_QUERY_LENGTH_AA=100000   # max total amino acids per submission
MAX_SEQUENCES_PER_JOB=100    # max FASTA records per submission

# ── Queue / concurrency ───────────────────────────────────────────────────────
# Run scripts/compute_concurrency.sh to get a recommended value for your server.
CELERY_CONCURRENCY=4
MAX_QUEUE_DEPTH=16           # CELERY_CONCURRENCY * 4 is a good default
MAX_CONCURRENT_DBS=3         # max distinct BLAST DBs active simultaneously
MEMORY_FLOOR_MB=512          # hard-reject jobs below this free RAM (MB)

# ── Result retention ──────────────────────────────────────────────────────────
RESULT_TTL_S=86400           # 24 hours

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_SUBMIT_PER_MINUTE=10
RATE_LIMIT_SUBMIT_PER_HOUR=100

# ── Flower monitoring dashboard ───────────────────────────────────────────────
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=admin:changeme
